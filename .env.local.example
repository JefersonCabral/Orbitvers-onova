# Copie este arquivo para .env.local e preencha com os valores reais
# cp .env.local.example .env.local
# IMPORTANTE: NUNCA suba o .env.local no GitHub

# URL do webhook que retorna as estatísticas públicas (total_campaigns, total_messages)
# Usado em produção pelo statsService.ts
VITE_STATS_WEBHOOK_URL=SUA_URL_WEBHOOK_AQUI

# (Opcional) URL alternativa do servidor de stats local/staging
# Se definida, sobrescreve o VITE_STATS_WEBHOOK_URL
# VITE_STATS_SERVER_URL=http://localhost:3001

# Chave da API Gemini (se utilizada no projeto)
# GEMINI_API_KEY=SUA_CHAVE_AQUI

# Configurações do banco de dados (usado pelo stats-server.js)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SEU_NOME_DO_BANCO
DB_USER=SEU_USUARIO_DO_BANCO
DB_PASSWORD=SUA_SENHA_DO_BANCO
